{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "What the proxy was derived from: the recipe and the parameter values, with their badges.",
  "properties": {
    "method": {
      "const": "added-primitives",
      "default": "added-primitives",
      "title": "Method",
      "type": "string"
    },
    "shape": {
      "$ref": "#/$defs/Provenance"
    },
    "parameters": {
      "items": {
        "$ref": "#/$defs/ParameterUse"
      },
      "title": "Parameters",
      "type": "array"
    },
    "input_badges": {
      "items": {
        "$ref": "#/$defs/Badge"
      },
      "title": "Input Badges",
      "type": "array"
    },
    "assumptions": {
      "items": {
        "type": "string"
      },
      "title": "Assumptions",
      "type": "array"
    }
  },
  "required": [
    "shape",
    "parameters",
    "input_badges",
    "assumptions"
  ],
  "title": "ProxyDerivation",
  "type": "object",
  "$defs": {
    "Badge": {
      "enum": [
        "sim",
        "cite",
        "default",
        "declared",
        "estimate"
      ],
      "title": "Badge",
      "type": "string"
    },
    "ParameterUse": {
      "additionalProperties": false,
      "description": "The value one length parameter had in this computation, with the badge and source it came with.",
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/Quantity"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "ParameterUse",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Badge and source, both required.\n\nA cited (`cite`) value must say where in the source (locator or url). `license` belongs to cited values only;\n`declared_by` and `declared_at` belong to declared values only.",
      "properties": {
        "badge": {
          "$ref": "#/$defs/Badge"
        },
        "source": {
          "$ref": "#/$defs/Source"
        }
      },
      "required": [
        "badge",
        "source"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "description": "One physical number with its unit, badge and source.",
      "properties": {
        "badge": {
          "$ref": "#/$defs/Badge"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        }
      },
      "required": [
        "badge",
        "source",
        "value",
        "unit"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "description": "Where a value comes from.\n\n`ref` is what was cited, declared or run: a document, a datasheet, a run id, or the reason a default was chosen\n(for an estimate: the method and its inputs). `locator` is where inside it (table, page, section). `url` is a\nlink when there is one. `license` (SPDX expression over the repo allowlist, `spdx.py`) and `declared_by` / `declared_at` feed the badge popover\n(`ValueBadges`, 인용 and 사용자 선언); `Provenance` allows each only on its own badge.",
      "properties": {
        "ref": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        },
        "locator": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        },
        "url": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "license": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "declared_by": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declared By"
        },
        "declared_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declared At"
        }
      },
      "required": [
        "ref"
      ],
      "title": "Source",
      "type": "object"
    },
    "Unit": {
      "description": "Closed unit vocabulary (SI, written the way the JSON carries it).",
      "enum": [
        "1",
        "m",
        "m^2",
        "m^3",
        "kg",
        "s",
        "rad",
        "m/s",
        "m/s^2",
        "rad/s",
        "N",
        "N*m",
        "N/m",
        "N*s/m",
        "N*m/rad",
        "Pa",
        "kg/m^3",
        "kg*m^2",
        "J",
        "W",
        "W/m^2",
        "V",
        "A"
      ],
      "title": "Unit",
      "type": "string"
    }
  }
}
