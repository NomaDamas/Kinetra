{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "part_id": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Part Id",
      "type": "string"
    },
    "volume": {
      "$ref": "#/$defs/DerivedScalar"
    },
    "mass": {
      "$ref": "#/$defs/DerivedScalar"
    },
    "center_of_mass": {
      "$ref": "#/$defs/DerivedVector"
    },
    "inertia": {
      "$ref": "#/$defs/DerivedInertia"
    },
    "derivation": {
      "$ref": "#/$defs/Derivation"
    }
  },
  "required": [
    "part_id",
    "volume",
    "mass",
    "center_of_mass",
    "inertia",
    "derivation"
  ],
  "title": "MassProperties",
  "type": "object",
  "$defs": {
    "Badge": {
      "enum": [
        "sim",
        "cite",
        "default",
        "declared",
        "estimate"
      ],
      "title": "Badge",
      "type": "string"
    },
    "ComponentContribution": {
      "additionalProperties": false,
      "description": "What one shape component added or removed, with the values it was evaluated at.\n\n`dimensions` are the primitive's resolved lengths in metres under the field names of `shape.py` (`size_x`, `radius`,\n`length`, ...), `center` its resolved position in the part frame and `orientation` its rotation about that centre.\n`volume` and `mass` are positive; `operation` says which way they count.",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "primitive": {
          "enum": [
            "box",
            "cylinder",
            "sphere"
          ],
          "title": "Primitive",
          "type": "string"
        },
        "operation": {
          "enum": [
            "add",
            "subtract"
          ],
          "title": "Operation",
          "type": "string"
        },
        "dimensions": {
          "items": {
            "$ref": "#/$defs/Dimension"
          },
          "title": "Dimensions",
          "type": "array"
        },
        "volume": {
          "title": "Volume",
          "type": "number"
        },
        "mass": {
          "title": "Mass",
          "type": "number"
        },
        "center": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Center",
          "type": "array"
        },
        "orientation": {
          "$ref": "#/$defs/Quaternion"
        }
      },
      "required": [
        "id",
        "primitive",
        "operation",
        "dimensions",
        "volume",
        "mass",
        "center",
        "orientation"
      ],
      "title": "ComponentContribution",
      "type": "object"
    },
    "Density": {
      "additionalProperties": false,
      "properties": {
        "badge": {
          "$ref": "#/$defs/Badge"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "value": {
          "exclusiveMinimum": 0,
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "const": "kg/m^3",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "badge",
        "source",
        "value",
        "unit"
      ],
      "title": "Density",
      "type": "object"
    },
    "Derivation": {
      "additionalProperties": false,
      "description": "Everything the numbers were computed from, so a reviewer can redo them by hand.",
      "properties": {
        "method": {
          "const": "analytic-primitives",
          "default": "analytic-primitives",
          "title": "Method",
          "type": "string"
        },
        "shape": {
          "$ref": "#/$defs/Provenance"
        },
        "material_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Material Id",
          "type": "string"
        },
        "density": {
          "$ref": "#/$defs/Density"
        },
        "parameters": {
          "items": {
            "$ref": "#/$defs/ParameterUse"
          },
          "title": "Parameters",
          "type": "array"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/ComponentContribution"
          },
          "title": "Components",
          "type": "array"
        },
        "input_badges": {
          "items": {
            "$ref": "#/$defs/Badge"
          },
          "title": "Input Badges",
          "type": "array"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        }
      },
      "required": [
        "shape",
        "material_id",
        "density",
        "parameters",
        "components",
        "input_badges",
        "assumptions"
      ],
      "title": "Derivation",
      "type": "object"
    },
    "DerivedInertia": {
      "additionalProperties": false,
      "description": "Inertia tensor about the centre of mass, in the part's axes [kg*m^2].",
      "properties": {
        "badge": {
          "const": "sim",
          "title": "Badge",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "ixx": {
          "title": "Ixx",
          "type": "number"
        },
        "iyy": {
          "title": "Iyy",
          "type": "number"
        },
        "izz": {
          "title": "Izz",
          "type": "number"
        },
        "ixy": {
          "title": "Ixy",
          "type": "number"
        },
        "ixz": {
          "title": "Ixz",
          "type": "number"
        },
        "iyz": {
          "title": "Iyz",
          "type": "number"
        },
        "unit": {
          "const": "kg*m^2",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "badge",
        "source",
        "ixx",
        "iyy",
        "izz",
        "ixy",
        "ixz",
        "iyz",
        "unit"
      ],
      "title": "DerivedInertia",
      "type": "object"
    },
    "DerivedScalar": {
      "additionalProperties": false,
      "properties": {
        "badge": {
          "const": "sim",
          "title": "Badge",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        }
      },
      "required": [
        "badge",
        "source",
        "value",
        "unit"
      ],
      "title": "DerivedScalar",
      "type": "object"
    },
    "DerivedVector": {
      "additionalProperties": false,
      "description": "A point in the part's local frame [m].",
      "properties": {
        "badge": {
          "const": "sim",
          "title": "Badge",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "z": {
          "title": "Z",
          "type": "number"
        },
        "unit": {
          "const": "m",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "badge",
        "source",
        "x",
        "y",
        "z",
        "unit"
      ],
      "title": "DerivedVector",
      "type": "object"
    },
    "Dimension": {
      "additionalProperties": false,
      "description": "One resolved length of a primitive, in metres, under the field name `shape.py` gives it.",
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "Dimension",
      "type": "object"
    },
    "ParameterUse": {
      "additionalProperties": false,
      "description": "The value one length parameter had in this computation, with the badge and source it came with.",
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/Quantity"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "ParameterUse",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Badge and source, both required.\n\nA cited (`cite`) value must say where in the source (locator or url). `license` belongs to cited values only;\n`declared_by` and `declared_at` belong to declared values only.",
      "properties": {
        "badge": {
          "$ref": "#/$defs/Badge"
        },
        "source": {
          "$ref": "#/$defs/Source"
        }
      },
      "required": [
        "badge",
        "source"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "description": "One physical number with its unit, badge and source.",
      "properties": {
        "badge": {
          "$ref": "#/$defs/Badge"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        }
      },
      "required": [
        "badge",
        "source",
        "value",
        "unit"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "Quaternion": {
      "additionalProperties": false,
      "description": "Unit quaternion with named components (`conventions.py`).",
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "z": {
          "title": "Z",
          "type": "number"
        },
        "w": {
          "title": "W",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z",
        "w"
      ],
      "title": "Quaternion",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "description": "Where a value comes from.\n\n`ref` is what was cited, declared or run: a document, a datasheet, a run id, or the reason a default was chosen\n(for an estimate: the method and its inputs). `locator` is where inside it (table, page, section). `url` is a\nlink when there is one. `license` (SPDX expression over the repo allowlist, `spdx.py`) and `declared_by` / `declared_at` feed the badge popover\n(`ValueBadges`, 인용 and 사용자 선언); `Provenance` allows each only on its own badge.",
      "properties": {
        "ref": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        },
        "locator": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        },
        "url": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "license": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "declared_by": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declared By"
        },
        "declared_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declared At"
        }
      },
      "required": [
        "ref"
      ],
      "title": "Source",
      "type": "object"
    },
    "Unit": {
      "description": "Closed unit vocabulary (SI, written the way the JSON carries it).",
      "enum": [
        "1",
        "m",
        "m^2",
        "m^3",
        "kg",
        "s",
        "rad",
        "m/s",
        "m/s^2",
        "rad/s",
        "N",
        "N*m",
        "N/m",
        "N*s/m",
        "N*m/rad",
        "Pa",
        "kg/m^3",
        "kg*m^2",
        "J",
        "W"
      ],
      "title": "Unit",
      "type": "string"
    }
  }
}
