{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A non-negative mass in kilograms.",
  "properties": {
    "value": {
      "minimum": 0,
      "title": "Value",
      "type": "number"
    },
    "unit": {
      "const": "kg",
      "title": "Unit",
      "type": "string"
    }
  },
  "required": [
    "value",
    "unit"
  ],
  "title": "MassKg",
  "type": "object"
}
