{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "What one shape component added or removed, with the values it was evaluated at.\n\n`dimensions` are the primitive's resolved lengths in metres under the field names of `shape.py` (`size_x`, `radius`,\n`length`, ...), `center` its resolved position in the part frame and `orientation` its rotation about that centre.\n`volume` and `mass` are positive; `operation` says which way they count.",
  "properties": {
    "id": {
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "title": "Id",
      "type": "string"
    },
    "primitive": {
      "enum": [
        "box",
        "cylinder",
        "sphere"
      ],
      "title": "Primitive",
      "type": "string"
    },
    "operation": {
      "enum": [
        "add",
        "subtract"
      ],
      "title": "Operation",
      "type": "string"
    },
    "dimensions": {
      "items": {
        "$ref": "#/$defs/Dimension"
      },
      "title": "Dimensions",
      "type": "array"
    },
    "volume": {
      "title": "Volume",
      "type": "number"
    },
    "mass": {
      "title": "Mass",
      "type": "number"
    },
    "center": {
      "maxItems": 3,
      "minItems": 3,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Center",
      "type": "array"
    },
    "orientation": {
      "$ref": "#/$defs/Quaternion"
    }
  },
  "required": [
    "id",
    "primitive",
    "operation",
    "dimensions",
    "volume",
    "mass",
    "center",
    "orientation"
  ],
  "title": "ComponentContribution",
  "type": "object",
  "$defs": {
    "Dimension": {
      "additionalProperties": false,
      "description": "One resolved length of a primitive, in metres, under the field name `shape.py` gives it.",
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "Dimension",
      "type": "object"
    },
    "Quaternion": {
      "additionalProperties": false,
      "description": "Unit quaternion with named components (`conventions.py`).",
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "z": {
          "title": "Z",
          "type": "number"
        },
        "w": {
          "title": "W",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z",
        "w"
      ],
      "title": "Quaternion",
      "type": "object"
    }
  }
}
