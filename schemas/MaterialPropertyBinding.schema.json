{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Bind an assumption to one physical property of a material carried by the project.",
  "properties": {
    "kind": {
      "const": "material_property",
      "title": "Kind",
      "type": "string"
    },
    "material": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Material",
      "type": "string"
    },
    "property": {
      "enum": [
        "density",
        "yield_strength",
        "elastic_modulus",
        "friction"
      ],
      "title": "Property",
      "type": "string"
    }
  },
  "required": [
    "kind",
    "material",
    "property"
  ],
  "title": "MaterialPropertyBinding",
  "type": "object"
}
