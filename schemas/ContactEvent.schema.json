{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "`body` touches (`phase` `begin`) or stops touching (`end`) `other`: another body, a terrain prop (by its id in\nthe project's world) or the ground (`other` is `None`). `force` is the contact force at `begin`, if known.",
  "properties": {
    "kind": {
      "const": "contact",
      "title": "Kind",
      "type": "string"
    },
    "tick": {
      "maximum": 4294967295,
      "minimum": 0,
      "title": "Tick",
      "type": "integer"
    },
    "phase": {
      "enum": [
        "begin",
        "end"
      ],
      "title": "Phase",
      "type": "string"
    },
    "body": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Body",
      "type": "string"
    },
    "other_kind": {
      "$ref": "#/$defs/GroundOrProp"
    },
    "other": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Other"
    },
    "force": {
      "anyOf": [
        {
          "$ref": "#/$defs/ForceN"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "kind",
    "tick",
    "phase",
    "body",
    "other_kind"
  ],
  "title": "ContactEvent",
  "type": "object",
  "$defs": {
    "ForceN": {
      "description": "A force in newtons (`unit` is always `N`, so a client never guesses).",
      "properties": {
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "const": "N",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "ForceN",
      "type": "object"
    },
    "GroundOrProp": {
      "enum": [
        "body",
        "prop",
        "ground"
      ],
      "title": "GroundOrProp",
      "type": "string"
    }
  }
}
