{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "What to tell the user after a project is opened: what is missing and what differs from the catalog.",
  "properties": {
    "missing": {
      "default": [],
      "items": {
        "$ref": "#/$defs/MissingDefinition"
      },
      "title": "Missing",
      "type": "array"
    },
    "differs_from_catalog": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CatalogDifference"
      },
      "title": "Differs From Catalog",
      "type": "array"
    }
  },
  "title": "OpenReport",
  "type": "object",
  "$defs": {
    "CatalogDifference": {
      "additionalProperties": false,
      "description": "A definition the project carries that differs from the catalog's definition with the same id. The project's\none is used.",
      "properties": {
        "kind": {
          "enum": [
            "material",
            "part"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "project_hash": {
          "title": "Project Hash",
          "type": "string"
        },
        "catalog_hash": {
          "title": "Catalog Hash",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "project_hash",
        "catalog_hash"
      ],
      "title": "CatalogDifference",
      "type": "object"
    },
    "MissingDefinition": {
      "additionalProperties": false,
      "description": "A definition the project does not carry, and the instances that use it (in project order).",
      "properties": {
        "kind": {
          "enum": [
            "material",
            "part"
          ],
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "instances": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Instances",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "id",
        "instances"
      ],
      "title": "MissingDefinition",
      "type": "object"
    }
  }
}
