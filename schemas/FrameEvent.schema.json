{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "discriminator": {
    "mapping": {
      "break": "#/$defs/BreakEvent",
      "condition_met": "#/$defs/ConditionMetEvent",
      "contact": "#/$defs/ContactEvent",
      "overturn": "#/$defs/OverturnEvent",
      "propellant_depleted": "#/$defs/PropellantDepletedEvent",
      "separation": "#/$defs/SeparationEvent",
      "slip": "#/$defs/SlipEvent",
      "torque_shortage": "#/$defs/TorqueShortageEvent"
    },
    "propertyName": "kind"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/ContactEvent"
    },
    {
      "$ref": "#/$defs/BreakEvent"
    },
    {
      "$ref": "#/$defs/SeparationEvent"
    },
    {
      "$ref": "#/$defs/ConditionMetEvent"
    },
    {
      "$ref": "#/$defs/OverturnEvent"
    },
    {
      "$ref": "#/$defs/SlipEvent"
    },
    {
      "$ref": "#/$defs/TorqueShortageEvent"
    },
    {
      "$ref": "#/$defs/PropellantDepletedEvent"
    }
  ],
  "$defs": {
    "BodyTarget": {
      "description": "What a body touched: another body of the run.",
      "properties": {
        "kind": {
          "const": "body",
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "BodyTarget",
      "type": "object"
    },
    "BreakEvent": {
      "description": "Joint `joint` released because the load on it went over its break threshold (both in N; plan 4.6, a simplified\nmodel). `reason` is the release's cause, `over_threshold` (\"임계 초과\"): only this one is a break (X-08).",
      "properties": {
        "kind": {
          "const": "break",
          "title": "Kind",
          "type": "string"
        },
        "tick": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Tick",
          "type": "integer"
        },
        "reason": {
          "const": "over_threshold",
          "title": "Reason",
          "type": "string"
        },
        "joint": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Joint",
          "type": "string"
        },
        "load": {
          "$ref": "#/$defs/ForceN"
        },
        "threshold": {
          "$ref": "#/$defs/ForceN"
        }
      },
      "required": [
        "kind",
        "tick",
        "reason",
        "joint",
        "load",
        "threshold"
      ],
      "title": "BreakEvent",
      "type": "object"
    },
    "ConditionMetEvent": {
      "description": "A success condition of the project became true. This is not a verdict (P4): it says the run satisfied it.",
      "properties": {
        "kind": {
          "const": "condition_met",
          "title": "Kind",
          "type": "string"
        },
        "tick": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Tick",
          "type": "integer"
        },
        "condition": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Condition",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "tick",
        "condition"
      ],
      "title": "ConditionMetEvent",
      "type": "object"
    },
    "ContactEvent": {
      "description": "`body` touches (`phase` `begin`) or stops touching (`end`) `other`. `force` is the contact force at `begin`,\nif known.",
      "properties": {
        "kind": {
          "const": "contact",
          "title": "Kind",
          "type": "string"
        },
        "tick": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Tick",
          "type": "integer"
        },
        "phase": {
          "enum": [
            "begin",
            "end"
          ],
          "title": "Phase",
          "type": "string"
        },
        "body": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Body",
          "type": "string"
        },
        "other": {
          "discriminator": {
            "mapping": {
              "body": "#/$defs/BodyTarget",
              "ground": "#/$defs/GroundTarget",
              "prop": "#/$defs/PropTarget"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/BodyTarget"
            },
            {
              "$ref": "#/$defs/PropTarget"
            },
            {
              "$ref": "#/$defs/GroundTarget"
            }
          ],
          "title": "Other"
        },
        "force": {
          "anyOf": [
            {
              "$ref": "#/$defs/ForceN"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "tick",
        "phase",
        "body",
        "other"
      ],
      "title": "ContactEvent",
      "type": "object"
    },
    "ForceN": {
      "description": "A force in newtons (`unit` is always `N`, so a client never guesses).",
      "properties": {
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "const": "N",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "ForceN",
      "type": "object"
    },
    "GroundTarget": {
      "additionalProperties": false,
      "description": "What a body touched: the ground. It has no id (the ground of the planet is one thing), so an `id` is refused.",
      "properties": {
        "kind": {
          "const": "ground",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "GroundTarget",
      "type": "object"
    },
    "ImpulseNs": {
      "description": "An impulse in newton-seconds (`unit` is always `N*s`).",
      "properties": {
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "const": "N*s",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "ImpulseNs",
      "type": "object"
    },
    "LengthM": {
      "description": "A signed length in metres (a support margin is negative outside the support region).",
      "properties": {
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "const": "m",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "LengthM",
      "type": "object"
    },
    "MassKg": {
      "description": "A non-negative mass in kilograms.",
      "properties": {
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "const": "kg",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "MassKg",
      "type": "object"
    },
    "OverturnEvent": {
      "description": "Observed centre-of-mass projection outside the support polygon. This is not automatically a failure cause:\n`grounded` is false after liftoff (the polygon is the last ground support), and J-06 excludes that observation.",
      "properties": {
        "kind": {
          "const": "overturn",
          "title": "Kind",
          "type": "string"
        },
        "tick": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Tick",
          "type": "integer"
        },
        "grounded": {
          "title": "Grounded",
          "type": "boolean"
        },
        "margin": {
          "$ref": "#/$defs/LengthM"
        },
        "reference_length": {
          "$ref": "#/$defs/LengthM"
        }
      },
      "required": [
        "kind",
        "tick",
        "grounded",
        "margin",
        "reference_length"
      ],
      "title": "OverturnEvent",
      "type": "object"
    },
    "PropTarget": {
      "description": "What a body touched: a terrain prop, by its id in the project's world.",
      "properties": {
        "kind": {
          "const": "prop",
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "PropTarget",
      "type": "object"
    },
    "PropellantDepletedEvent": {
      "description": "Observed empty tank. `unmet` distinguishes an unfulfilled thrust request from a scheduled burn that ended\nexactly as the tank became empty; only the former can become a J-06 cause.",
      "properties": {
        "kind": {
          "const": "propellant_depleted",
          "title": "Kind",
          "type": "string"
        },
        "tick": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Tick",
          "type": "integer"
        },
        "actuator": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Actuator",
          "type": "string"
        },
        "tank": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Tank",
          "type": "string"
        },
        "requested": {
          "$ref": "#/$defs/ForceN"
        },
        "available": {
          "$ref": "#/$defs/ForceN"
        },
        "remaining": {
          "$ref": "#/$defs/MassKg"
        },
        "unmet": {
          "title": "Unmet",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "tick",
        "actuator",
        "tank",
        "requested",
        "available",
        "remaining",
        "unmet"
      ],
      "title": "PropellantDepletedEvent",
      "type": "object"
    },
    "SeparationEvent": {
      "description": "Separator instance `separator` let go of joint `joint` on purpose (X-08): `reason` is `intended_separation` (\"의도한\n분리\"), never a break. Each side received the declared separation `impulse`, equal and opposite. `entry` is the schedule\nentry that asked for it, `null` for a manual request during the run. `tick` is the first tick whose state is apart.",
      "properties": {
        "kind": {
          "const": "separation",
          "title": "Kind",
          "type": "string"
        },
        "tick": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Tick",
          "type": "integer"
        },
        "reason": {
          "const": "intended_separation",
          "title": "Reason",
          "type": "string"
        },
        "separator": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Separator",
          "type": "string"
        },
        "joint": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Joint",
          "type": "string"
        },
        "entry": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Entry"
        },
        "impulse": {
          "$ref": "#/$defs/ImpulseNs"
        }
      },
      "required": [
        "kind",
        "tick",
        "reason",
        "separator",
        "joint",
        "entry",
        "impulse"
      ],
      "title": "SeparationEvent",
      "type": "object"
    },
    "SlipEvent": {
      "description": "Observed nonzero tangential contact force at or over its Coulomb friction limit, aggregated per body/target pair.",
      "properties": {
        "kind": {
          "const": "slip",
          "title": "Kind",
          "type": "string"
        },
        "tick": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Tick",
          "type": "integer"
        },
        "body": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Body",
          "type": "string"
        },
        "other": {
          "discriminator": {
            "mapping": {
              "body": "#/$defs/BodyTarget",
              "ground": "#/$defs/GroundTarget",
              "prop": "#/$defs/PropTarget"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/BodyTarget"
            },
            {
              "$ref": "#/$defs/PropTarget"
            },
            {
              "$ref": "#/$defs/GroundTarget"
            }
          ],
          "title": "Other"
        },
        "tangential": {
          "$ref": "#/$defs/ForceN"
        },
        "friction_limit": {
          "$ref": "#/$defs/ForceN"
        }
      },
      "required": [
        "kind",
        "tick",
        "body",
        "other",
        "tangential",
        "friction_limit"
      ],
      "title": "SlipEvent",
      "type": "object"
    },
    "TorqueNm": {
      "description": "A non-negative torque magnitude in newton-metres.",
      "properties": {
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "const": "N*m",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "TorqueNm",
      "type": "object"
    },
    "TorqueShortageEvent": {
      "description": "Observed motor command's zero-speed torque request over the speed- and supply-dependent available torque.",
      "properties": {
        "kind": {
          "const": "torque_shortage",
          "title": "Kind",
          "type": "string"
        },
        "tick": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Tick",
          "type": "integer"
        },
        "actuator": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Actuator",
          "type": "string"
        },
        "required": {
          "$ref": "#/$defs/TorqueNm"
        },
        "limit": {
          "$ref": "#/$defs/TorqueNm"
        }
      },
      "required": [
        "kind",
        "tick",
        "actuator",
        "required",
        "limit"
      ],
      "title": "TorqueShortageEvent",
      "type": "object"
    }
  }
}
