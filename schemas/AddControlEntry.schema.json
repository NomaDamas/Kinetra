{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "add_control_entry",
      "title": "Type",
      "type": "string"
    },
    "entry": {
      "$ref": "#/$defs/ActuateEntry"
    },
    "index": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Index"
    }
  },
  "required": [
    "type",
    "entry"
  ],
  "title": "AddControlEntry",
  "type": "object",
  "$defs": {
    "ActuateEntry": {
      "additionalProperties": false,
      "description": "Command `command` on `actuator` during `[start, end)` seconds of simulated time.\n\n`command` is the fraction of the actuator's full command, in [-1, 1] for a motor (sign is direction) and\n[0, 1] for a thruster. What full command means physically comes from the part (B-03b, B-03c, X-01b, X-01c).\nOne badge and source cover the entry.",
      "properties": {
        "badge": {
          "$ref": "#/$defs/Badge"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "type": {
          "const": "actuate",
          "title": "Type",
          "type": "string"
        },
        "actuator": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Actuator",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "number"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "number"
        },
        "command": {
          "maximum": 1,
          "minimum": -1,
          "title": "Command",
          "type": "number"
        }
      },
      "required": [
        "badge",
        "source",
        "type",
        "actuator",
        "start",
        "end",
        "command"
      ],
      "title": "ActuateEntry",
      "type": "object"
    },
    "Badge": {
      "enum": [
        "sim",
        "cite",
        "default",
        "declared",
        "estimate"
      ],
      "title": "Badge",
      "type": "string"
    },
    "Source": {
      "additionalProperties": false,
      "description": "Where a value comes from.\n\n`ref` is what was cited, declared or run: a document, a datasheet, a run id, or the reason a default was chosen\n(for an estimate: the method and its inputs). `locator` is where inside it (table, page, section). `url` is a\nlink when there is one. `license` (SPDX expression over the repo allowlist, `spdx.py`) and `declared_by` / `declared_at` feed the badge popover\n(`ValueBadges`, 인용 and 사용자 선언); `Provenance` allows each only on its own badge.",
      "properties": {
        "ref": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        },
        "locator": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        },
        "url": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "license": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "declared_by": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declared By"
        },
        "declared_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declared At"
        }
      },
      "required": [
        "ref"
      ],
      "title": "Source",
      "type": "object"
    }
  }
}
