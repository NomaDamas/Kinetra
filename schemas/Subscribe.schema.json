{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Follow a project. `after_revision` and `epoch` are the last revision the client holds and the `epoch` it came\nwith (a reconnect); `None` for a first subscription. Both are needed to be resumed: with only one the core\nanswers a `snapshot`. One subscription per connection; a second `subscribe` replaces it.",
  "properties": {
    "type": {
      "const": "subscribe",
      "title": "Type",
      "type": "string"
    },
    "project": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Project",
      "type": "string"
    },
    "after_revision": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "After Revision"
    },
    "epoch": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Epoch"
    }
  },
  "required": [
    "type",
    "project"
  ],
  "title": "Subscribe",
  "type": "object"
}
