{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A linear spring and viscous damper in parallel about a joint coordinate q:\nforce (torque) = -stiffness * q - damping * dq/dt.\n\nq is 0 at the saved pose (C-01b), so the spring is at rest where the part was placed. Stiffness and damping each\ncarry their own badge and source. They are a pair: N/m with N*s/m, or N*m/rad with N*m*s/rad. At least one is above\nzero (a spring that does nothing is left out). That the pair fits the joint's kind is the joint's check.",
  "properties": {
    "stiffness": {
      "$ref": "#/$defs/SpringStiffness"
    },
    "damping": {
      "$ref": "#/$defs/SpringDamping"
    }
  },
  "required": [
    "stiffness",
    "damping"
  ],
  "title": "JointSpring",
  "type": "object",
  "$defs": {
    "Badge": {
      "enum": [
        "sim",
        "cite",
        "default",
        "declared",
        "estimate"
      ],
      "title": "Badge",
      "type": "string"
    },
    "Source": {
      "additionalProperties": false,
      "description": "Where a value comes from.\n\n`ref` is what was cited, declared or run: a document, a datasheet, a run id, or the reason a default was chosen\n(for an estimate: the method and its inputs). `locator` is where inside it (table, page, section). `url` is a\nlink when there is one. `license` (SPDX expression over the repo allowlist, `spdx.py`) and `declared_by` / `declared_at` feed the badge popover\n(`ValueBadges`, 인용 and 사용자 선언); `Provenance` allows each only on its own badge.",
      "properties": {
        "ref": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        },
        "locator": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        },
        "url": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "license": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "declared_by": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declared By"
        },
        "declared_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declared At"
        }
      },
      "required": [
        "ref"
      ],
      "title": "Source",
      "type": "object"
    },
    "SpringDamping": {
      "additionalProperties": false,
      "description": "Resisting force (torque) per unit of joint speed: N*s/m on a slider, N*m*s/rad on a hinge. 0 is a pure spring.",
      "properties": {
        "badge": {
          "$ref": "#/$defs/Badge"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "enum": [
            "N*s/m",
            "N*m*s/rad"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "badge",
        "source",
        "value",
        "unit"
      ],
      "title": "SpringDamping",
      "type": "object"
    },
    "SpringStiffness": {
      "additionalProperties": false,
      "description": "Restoring force (torque) per unit of joint travel: N/m on a slider, N*m/rad on a hinge. 0 is a pure damper.",
      "properties": {
        "badge": {
          "$ref": "#/$defs/Badge"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "enum": [
            "N/m",
            "N*m/rad"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "badge",
        "source",
        "value",
        "unit"
      ],
      "title": "SpringStiffness",
      "type": "object"
    }
  }
}
