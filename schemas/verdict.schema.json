{
  "$defs": {
    "BindingConstraint": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "margin": {
          "description": "Signed slack in the constraint's units; <0 means violated.",
          "title": "Margin",
          "type": "number"
        },
        "unit": {
          "default": "",
          "title": "Unit",
          "type": "string"
        },
        "sensitivities": {
          "description": "Assumptions ranked by influence on this constraint.",
          "items": {
            "$ref": "#/$defs/Sensitivity"
          },
          "title": "Sensitivities",
          "type": "array"
        }
      },
      "required": [
        "name",
        "margin"
      ],
      "title": "BindingConstraint",
      "type": "object"
    },
    "BomItem": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "role": {
          "default": "",
          "title": "Role",
          "type": "string"
        },
        "quantity": {
          "default": 1,
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        },
        "mass_kg": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mass Kg"
        },
        "unit_cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit Cost Usd"
        },
        "source": {
          "default": "",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "BomItem",
      "type": "object"
    },
    "CostEstimate": {
      "additionalProperties": false,
      "properties": {
        "sim_cost": {
          "$ref": "#/$defs/SimCost"
        },
        "physical_equivalent_estimate": {
          "anyOf": [
            {
              "$ref": "#/$defs/PhysicalEquivalentEstimate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "sim_cost"
      ],
      "title": "CostEstimate",
      "type": "object"
    },
    "Feasibility": {
      "additionalProperties": false,
      "properties": {
        "p_success": {
          "maximum": 1,
          "minimum": 0,
          "title": "P Success",
          "type": "number"
        },
        "ci_low": {
          "maximum": 1,
          "minimum": 0,
          "title": "Ci Low",
          "type": "number"
        },
        "ci_high": {
          "maximum": 1,
          "minimum": 0,
          "title": "Ci High",
          "type": "number"
        },
        "n_samples": {
          "minimum": 0,
          "title": "N Samples",
          "type": "integer"
        },
        "ci_method": {
          "default": "wilson_95",
          "description": "How the CI was computed.",
          "title": "Ci Method",
          "type": "string"
        }
      },
      "required": [
        "p_success",
        "ci_low",
        "ci_high",
        "n_samples"
      ],
      "title": "Feasibility",
      "type": "object"
    },
    "HumanReview": {
      "additionalProperties": false,
      "properties": {
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/ReviewItem"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "required"
      ],
      "title": "HumanReview",
      "type": "object"
    },
    "NecessaryCheck": {
      "additionalProperties": false,
      "description": "A cheap analytic/static check; failing it proves infeasibility under the assumptions.",
      "properties": {
        "name": {
          "description": "e.g. 'energy_budget', 'static_torque_saturation', 'impulse'.",
          "title": "Name",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "measured": {
          "title": "Measured",
          "type": "number"
        },
        "limit": {
          "title": "Limit",
          "type": "number"
        },
        "unit": {
          "default": "",
          "title": "Unit",
          "type": "string"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "name",
        "passed",
        "measured",
        "limit"
      ],
      "title": "NecessaryCheck",
      "type": "object"
    },
    "ParamChange": {
      "additionalProperties": false,
      "properties": {
        "param": {
          "description": "A param_bounds name or assumption key.",
          "title": "Param",
          "type": "string"
        },
        "from_value": {
          "title": "From Value",
          "type": "number"
        },
        "to_value": {
          "title": "To Value",
          "type": "number"
        },
        "unit": {
          "default": "",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "param",
        "from_value",
        "to_value"
      ],
      "title": "ParamChange",
      "type": "object"
    },
    "PhysicalEquivalentEstimate": {
      "additionalProperties": false,
      "properties": {
        "is_estimate": {
          "const": true,
          "default": true,
          "title": "Is Estimate",
          "type": "boolean"
        },
        "low_usd": {
          "minimum": 0,
          "title": "Low Usd",
          "type": "number"
        },
        "high_usd": {
          "minimum": 0,
          "title": "High Usd",
          "type": "number"
        },
        "basis": {
          "title": "Basis",
          "type": "string"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "low_usd",
        "high_usd",
        "basis"
      ],
      "title": "PhysicalEquivalentEstimate",
      "type": "object"
    },
    "Reproducibility": {
      "additionalProperties": false,
      "properties": {
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "versions": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "e.g. {'mujoco': '3.2.0', 'cma': '3.3.0', 'physlab_core': '0.1.0'}.",
          "title": "Versions",
          "type": "object"
        },
        "search_budget": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "e.g. {'cma_evals': 2000, 'mc_samples': 500}.",
          "title": "Search Budget",
          "type": "object"
        },
        "spec_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Hash of the SpecSheet used.",
          "title": "Spec Hash"
        }
      },
      "required": [
        "seed",
        "versions",
        "search_budget"
      ],
      "title": "Reproducibility",
      "type": "object"
    },
    "ReviewItem": {
      "additionalProperties": false,
      "properties": {
        "assumption_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assumption Key"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "severity": {
          "default": "warn",
          "enum": [
            "info",
            "warn",
            "block"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "reason"
      ],
      "title": "ReviewItem",
      "type": "object"
    },
    "Sensitivity": {
      "additionalProperties": false,
      "properties": {
        "assumption_key": {
          "title": "Assumption Key",
          "type": "string"
        },
        "effect": {
          "description": "Signed change in p_success (or in the margin) per +1 std / full range of the assumption; see 'method'.",
          "title": "Effect",
          "type": "number"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "method": {
          "default": "one_at_a_time",
          "description": "e.g. 'one_at_a_time', 'sobol_total', 'spearman'.",
          "title": "Method",
          "type": "string"
        }
      },
      "required": [
        "assumption_key",
        "effect",
        "rank"
      ],
      "title": "Sensitivity",
      "type": "object"
    },
    "SimCost": {
      "additionalProperties": false,
      "properties": {
        "n_evals": {
          "minimum": 0,
          "title": "N Evals",
          "type": "integer"
        },
        "wall_seconds": {
          "minimum": 0,
          "title": "Wall Seconds",
          "type": "number"
        }
      },
      "required": [
        "n_evals",
        "wall_seconds"
      ],
      "title": "SimCost",
      "type": "object"
    },
    "SuggestedFix": {
      "additionalProperties": false,
      "description": "Produced by the optimizer, never by an LLM.",
      "properties": {
        "changes": {
          "items": {
            "$ref": "#/$defs/ParamChange"
          },
          "title": "Changes",
          "type": "array"
        },
        "rationale": {
          "description": "Generated from optimizer output (what changed, by how much, what it bought).",
          "title": "Rationale",
          "type": "string"
        },
        "verified": {
          "description": "True iff the changed configuration was re-simulated and met the success criteria.",
          "title": "Verified",
          "type": "boolean"
        },
        "verified_p_success": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verified P Success"
        }
      },
      "required": [
        "changes",
        "rationale",
        "verified"
      ],
      "title": "SuggestedFix",
      "type": "object"
    },
    "VerdictStatus": {
      "enum": [
        "FEASIBLE_FOUND",
        "INFEASIBLE_NECESSARY_CONDITION",
        "NOT_FOUND_IN_BUDGET",
        "MODEL_INVALID"
      ],
      "title": "VerdictStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/VerdictStatus"
    },
    "summary": {
      "description": "One or two plain-language sentences. For NOT_FOUND_IN_BUDGET must be worded as weak evidence, not impossibility.",
      "title": "Summary",
      "type": "string"
    },
    "feasibility": {
      "$ref": "#/$defs/Feasibility"
    },
    "necessary_checks": {
      "items": {
        "$ref": "#/$defs/NecessaryCheck"
      },
      "title": "Necessary Checks",
      "type": "array"
    },
    "binding_constraint": {
      "anyOf": [
        {
          "$ref": "#/$defs/BindingConstraint"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "best_params": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Best Params",
      "type": "object"
    },
    "suggested_fix": {
      "anyOf": [
        {
          "$ref": "#/$defs/SuggestedFix"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "bom": {
      "items": {
        "$ref": "#/$defs/BomItem"
      },
      "title": "Bom",
      "type": "array"
    },
    "cost_estimate": {
      "anyOf": [
        {
          "$ref": "#/$defs/CostEstimate"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "model_labels": {
      "description": "Uncertainty labels, e.g. 'simplified model, needs precise validation' (mandatory for CFD/thermal/FEA-like submodels).",
      "items": {
        "type": "string"
      },
      "title": "Model Labels",
      "type": "array"
    },
    "human_review": {
      "$ref": "#/$defs/HumanReview"
    },
    "reproducibility": {
      "$ref": "#/$defs/Reproducibility"
    },
    "trajectory_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Path/URL of the best-run Trajectory JSON.",
      "title": "Trajectory Ref"
    }
  },
  "required": [
    "status",
    "summary",
    "feasibility",
    "human_review",
    "reproducibility"
  ],
  "title": "Verdict",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
