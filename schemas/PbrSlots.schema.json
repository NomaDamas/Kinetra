{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "base_color": {
      "$ref": "#/$defs/PbrColor"
    },
    "metallic": {
      "$ref": "#/$defs/PbrScalar"
    },
    "roughness": {
      "$ref": "#/$defs/PbrScalar"
    },
    "reflectance": {
      "$ref": "#/$defs/PbrScalar"
    }
  },
  "required": [
    "base_color",
    "metallic",
    "roughness",
    "reflectance"
  ],
  "title": "PbrSlots",
  "type": "object",
  "$defs": {
    "Badge": {
      "enum": [
        "sim",
        "cite",
        "default",
        "declared",
        "estimate"
      ],
      "title": "Badge",
      "type": "string"
    },
    "PbrColor": {
      "additionalProperties": false,
      "description": "Base color as sRGB hex.",
      "properties": {
        "badge": {
          "$ref": "#/$defs/Badge"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "srgb": {
          "pattern": "^#[0-9a-f]{6}$",
          "title": "Srgb",
          "type": "string"
        }
      },
      "required": [
        "badge",
        "source",
        "srgb"
      ],
      "title": "PbrColor",
      "type": "object"
    },
    "PbrScalar": {
      "additionalProperties": false,
      "description": "A dimensionless slot value in [0, 1].",
      "properties": {
        "badge": {
          "$ref": "#/$defs/Badge"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "value": {
          "maximum": 1,
          "minimum": 0,
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "const": "1",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "badge",
        "source",
        "value",
        "unit"
      ],
      "title": "PbrScalar",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "description": "Where a value comes from.\n\n`ref` is what was cited, declared or run: a document, a datasheet, a run id, or the reason a default was chosen\n(for an estimate: the method and its inputs). `locator` is where inside it (table, page, section). `url` is a\nlink when there is one. `license` (SPDX expression over the repo allowlist, `spdx.py`) and `declared_by` / `declared_at` feed the badge popover\n(`ValueBadges`, 인용 and 사용자 선언); `Provenance` allows each only on its own badge.",
      "properties": {
        "ref": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        },
        "locator": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        },
        "url": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "license": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "declared_by": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declared By"
        },
        "declared_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declared At"
        }
      },
      "required": [
        "ref"
      ],
      "title": "Source",
      "type": "object"
    }
  }
}
