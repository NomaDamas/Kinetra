{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Remove the assumption with this key. Refused (`not_editable`) when it is not `editable`.",
  "properties": {
    "type": {
      "const": "remove_assumption",
      "title": "Type",
      "type": "string"
    },
    "key": {
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "title": "Key",
      "type": "string"
    }
  },
  "required": [
    "type",
    "key"
  ],
  "title": "RemoveAssumption",
  "type": "object"
}
