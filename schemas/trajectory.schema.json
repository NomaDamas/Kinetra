{
  "$defs": {
    "ContactEvent": {
      "additionalProperties": false,
      "properties": {
        "t": {
          "description": "Seconds from start.",
          "title": "T",
          "type": "number"
        },
        "kind": {
          "default": "contact",
          "enum": [
            "contact",
            "impact",
            "thrust",
            "landing",
            "failure",
            "custom"
          ],
          "title": "Kind",
          "type": "string"
        },
        "body": {
          "description": "Primary body name.",
          "title": "Body",
          "type": "string"
        },
        "other": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Other body name, or null for world/ground.",
          "title": "Other"
        },
        "pos": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pos"
        },
        "force": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "World-frame force vector [N].",
          "title": "Force"
        },
        "magnitude": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Scalar force/impulse magnitude; unit in 'note' if not N.",
          "title": "Magnitude"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "t",
        "body"
      ],
      "title": "ContactEvent",
      "type": "object"
    },
    "Geom": {
      "additionalProperties": false,
      "description": "Render hint for one geom attached to a body (MuJoCo geom_size semantics).",
      "properties": {
        "type": {
          "$ref": "#/$defs/GeomType"
        },
        "size": {
          "description": "MuJoCo geom size: box=half-extents[3], sphere=[r], capsule/cylinder=[r, half_len], plane=[hx,hy,grid].",
          "items": {
            "type": "number"
          },
          "title": "Size",
          "type": "array"
        },
        "pos": {
          "description": "Local to the body frame.",
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Pos",
          "type": "array"
        },
        "quat": {
          "description": "[w,x,y,z], local to the body frame.",
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Quat",
          "type": "array"
        },
        "rgba": {
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Rgba",
          "type": "array"
        },
        "mesh": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Asset name/URL when type == 'mesh'.",
          "title": "Mesh"
        }
      },
      "required": [
        "type",
        "size"
      ],
      "title": "Geom",
      "type": "object"
    },
    "GeomType": {
      "enum": [
        "box",
        "sphere",
        "capsule",
        "cylinder",
        "ellipsoid",
        "plane",
        "mesh"
      ],
      "title": "GeomType",
      "type": "string"
    },
    "TemplateId": {
      "enum": [
        "rocket_car",
        "humanoid_jump",
        "drone",
        "custom"
      ],
      "title": "TemplateId",
      "type": "string"
    },
    "TimeSeries": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "e.g. 'thrust_N', 'pitch_deg', 'joint_torque_knee'.",
          "title": "Name",
          "type": "string"
        },
        "unit": {
          "default": "",
          "title": "Unit",
          "type": "string"
        },
        "values": {
          "description": "One value per frame.",
          "items": {
            "type": "number"
          },
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "name",
        "values"
      ],
      "title": "TimeSeries",
      "type": "object"
    },
    "TrajBody": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Parent body name; null for children of the world.",
          "title": "Parent"
        },
        "geoms": {
          "items": {
            "$ref": "#/$defs/Geom"
          },
          "title": "Geoms",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "TrajBody",
      "type": "object"
    },
    "TrajectoryMeta": {
      "additionalProperties": false,
      "properties": {
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "mujoco_version": {
          "title": "Mujoco Version",
          "type": "string"
        },
        "template_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/TemplateId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "params": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "Search parameters that produced this rollout.",
          "title": "Params",
          "type": "object"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "seed",
        "mujoco_version"
      ],
      "title": "TrajectoryMeta",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "model_id": {
      "description": "Human label of the model, e.g. 'rocket_car_v1'.",
      "title": "Model Id",
      "type": "string"
    },
    "model_hash": {
      "description": "Hash (e.g. sha256 hex) of the compiled MJCF XML used.",
      "title": "Model Hash",
      "type": "string"
    },
    "dt": {
      "description": "Seconds between stored frames (may be a multiple of the physics timestep).",
      "exclusiveMinimum": 0,
      "title": "Dt",
      "type": "number"
    },
    "bodies": {
      "items": {
        "$ref": "#/$defs/TrajBody"
      },
      "title": "Bodies",
      "type": "array"
    },
    "pos": {
      "description": "[frame][body][x,y,z] world position, metres.",
      "items": {
        "items": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "type": "array"
      },
      "title": "Pos",
      "type": "array"
    },
    "quat": {
      "description": "[frame][body][w,x,y,z] world orientation.",
      "items": {
        "items": {
          "items": {
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "type": "array"
      },
      "title": "Quat",
      "type": "array"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/ContactEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "series": {
      "items": {
        "$ref": "#/$defs/TimeSeries"
      },
      "title": "Series",
      "type": "array"
    },
    "meta": {
      "$ref": "#/$defs/TrajectoryMeta"
    }
  },
  "required": [
    "model_id",
    "model_hash",
    "dt",
    "bodies",
    "pos",
    "quat",
    "meta"
  ],
  "title": "Trajectory",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
