{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Position [m] and orientation (unit quaternion `x, y, z, w`) of body `body`, in the world frame.",
  "properties": {
    "body": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Body",
      "type": "string"
    },
    "position": {
      "$ref": "#/$defs/WorldPosition"
    },
    "orientation": {
      "$ref": "#/$defs/Quaternion"
    }
  },
  "required": [
    "body",
    "position",
    "orientation"
  ],
  "title": "BodyPose",
  "type": "object",
  "$defs": {
    "Quaternion": {
      "additionalProperties": false,
      "description": "Unit quaternion with named components (`conventions.py`).",
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "z": {
          "title": "Z",
          "type": "number"
        },
        "w": {
          "title": "W",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z",
        "w"
      ],
      "title": "Quaternion",
      "type": "object"
    },
    "WorldPosition": {
      "additionalProperties": false,
      "description": "A position in metres, world frame.",
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "z": {
          "title": "Z",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "title": "WorldPosition",
      "type": "object"
    }
  }
}
