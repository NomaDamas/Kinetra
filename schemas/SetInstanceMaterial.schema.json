{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Assign a material of the project to an instance; `None` assigns none.",
  "properties": {
    "type": {
      "const": "set_instance_material",
      "title": "Type",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Id",
      "type": "string"
    },
    "material": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Material"
    }
  },
  "required": [
    "type",
    "id",
    "material"
  ],
  "title": "SetInstanceMaterial",
  "type": "object"
}
