{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Inertia tensor about the centre of mass, in the part's axes [kg*m^2].",
  "properties": {
    "badge": {
      "const": "sim",
      "title": "Badge",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/Source"
    },
    "ixx": {
      "title": "Ixx",
      "type": "number"
    },
    "iyy": {
      "title": "Iyy",
      "type": "number"
    },
    "izz": {
      "title": "Izz",
      "type": "number"
    },
    "ixy": {
      "title": "Ixy",
      "type": "number"
    },
    "ixz": {
      "title": "Ixz",
      "type": "number"
    },
    "iyz": {
      "title": "Iyz",
      "type": "number"
    },
    "unit": {
      "const": "kg*m^2",
      "title": "Unit",
      "type": "string"
    }
  },
  "required": [
    "badge",
    "source",
    "ixx",
    "iyy",
    "izz",
    "ixy",
    "ixz",
    "iyz",
    "unit"
  ],
  "title": "DerivedInertia",
  "type": "object",
  "$defs": {
    "Source": {
      "additionalProperties": false,
      "description": "Where a value comes from.\n\n`ref` is what was cited, declared or run: a document, a datasheet, a run id, or the reason a default was chosen\n(for an estimate: the method and its inputs). `locator` is where inside it (table, page, section). `url` is a\nlink when there is one. `license` (SPDX expression over the repo allowlist, `spdx.py`) and `declared_by` / `declared_at` feed the badge popover\n(`ValueBadges`, 인용 and 사용자 선언); `Provenance` allows each only on its own badge.",
      "properties": {
        "ref": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        },
        "locator": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        },
        "url": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "license": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "declared_by": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declared By"
        },
        "declared_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declared At"
        }
      },
      "required": [
        "ref"
      ],
      "title": "Source",
      "type": "object"
    }
  }
}
