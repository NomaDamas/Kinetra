{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "add_actuator",
      "title": "Type",
      "type": "string"
    },
    "actuator": {
      "$ref": "#/$defs/Actuator"
    },
    "index": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Index"
    }
  },
  "required": [
    "type",
    "actuator"
  ],
  "title": "AddActuator",
  "type": "object",
  "$defs": {
    "Actuator": {
      "additionalProperties": false,
      "description": "Something on `instance` that a command drives. A motor drives one joint (`joint`); a thruster has none.",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ActuatorKind"
        },
        "instance": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Instance",
          "type": "string"
        },
        "joint": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Joint"
        }
      },
      "required": [
        "id",
        "kind",
        "instance"
      ],
      "title": "Actuator",
      "type": "object"
    },
    "ActuatorKind": {
      "enum": [
        "motor",
        "thruster"
      ],
      "title": "ActuatorKind",
      "type": "string"
    }
  }
}
