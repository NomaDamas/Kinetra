{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Distributed as a package wheel (PyPI): the hash of the distributed file identifies the binary.",
  "properties": {
    "name": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "version": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Version",
      "type": "string"
    },
    "distribution": {
      "const": "wheel",
      "title": "Distribution",
      "type": "string"
    },
    "artifact_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Artifact Hash",
      "type": "string"
    }
  },
  "required": [
    "name",
    "version",
    "distribution",
    "artifact_hash"
  ],
  "title": "WheelEngine",
  "type": "object"
}
