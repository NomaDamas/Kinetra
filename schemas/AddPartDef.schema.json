{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Put a part definition into the project (`DesignSpec` carries the definitions it uses).",
  "properties": {
    "type": {
      "const": "add_part_def",
      "title": "Type",
      "type": "string"
    },
    "part": {
      "$ref": "#/$defs/PartDef"
    },
    "index": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Index"
    }
  },
  "required": [
    "type",
    "part"
  ],
  "title": "AddPartDef",
  "type": "object",
  "$defs": {
    "AxisExpr": {
      "additionalProperties": false,
      "description": "A length in metres: `offset + sum(factor * param)`. A snap point coordinate in the part's local frame, or a\ndimension of a shape component (`shape.py`). Every `param` is a length parameter of the part.",
      "properties": {
        "offset": {
          "title": "Offset",
          "type": "number"
        },
        "terms": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ParamTerm"
          },
          "title": "Terms",
          "type": "array"
        }
      },
      "required": [
        "offset"
      ],
      "title": "AxisExpr",
      "type": "object"
    },
    "Badge": {
      "enum": [
        "sim",
        "cite",
        "default",
        "declared",
        "estimate"
      ],
      "title": "Badge",
      "type": "string"
    },
    "Box": {
      "additionalProperties": false,
      "description": "Rectangular block. `size_*` are full extents [m] along the component's local x, y, z.",
      "properties": {
        "kind": {
          "const": "box",
          "title": "Kind",
          "type": "string"
        },
        "size_x": {
          "$ref": "#/$defs/AxisExpr"
        },
        "size_y": {
          "$ref": "#/$defs/AxisExpr"
        },
        "size_z": {
          "$ref": "#/$defs/AxisExpr"
        }
      },
      "required": [
        "kind",
        "size_x",
        "size_y",
        "size_z"
      ],
      "title": "Box",
      "type": "object"
    },
    "Curve": {
      "additionalProperties": false,
      "description": "Piecewise-linear `y(x)`: at least two points, `x` strictly increasing, in `x_unit` and `y_unit`.",
      "properties": {
        "badge": {
          "$ref": "#/$defs/Badge"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "x_unit": {
          "$ref": "#/$defs/Unit"
        },
        "y_unit": {
          "$ref": "#/$defs/Unit"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/CurvePoint"
          },
          "minItems": 2,
          "title": "Points",
          "type": "array"
        }
      },
      "required": [
        "badge",
        "source",
        "x_unit",
        "y_unit",
        "points"
      ],
      "title": "Curve",
      "type": "object"
    },
    "CurvePoint": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "CurvePoint",
      "type": "object"
    },
    "Cylinder": {
      "additionalProperties": false,
      "description": "Solid circular cylinder. `radius` and `length` [m]; the axis is the component's local z.",
      "properties": {
        "kind": {
          "const": "cylinder",
          "title": "Kind",
          "type": "string"
        },
        "radius": {
          "$ref": "#/$defs/AxisExpr"
        },
        "length": {
          "$ref": "#/$defs/AxisExpr"
        }
      },
      "required": [
        "kind",
        "radius",
        "length"
      ],
      "title": "Cylinder",
      "type": "object"
    },
    "NamedCurve": {
      "additionalProperties": false,
      "description": "A curve a part defines under a name (`torque_speed` for a motor, `thrust` for a thruster).",
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "curve": {
          "$ref": "#/$defs/Curve"
        }
      },
      "required": [
        "name",
        "curve"
      ],
      "title": "NamedCurve",
      "type": "object"
    },
    "ParamDef": {
      "additionalProperties": false,
      "description": "A named parameter of the part with its default and allowed range, all in `unit`.",
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        },
        "default": {
          "$ref": "#/$defs/Quantity"
        },
        "min": {
          "$ref": "#/$defs/Quantity"
        },
        "max": {
          "$ref": "#/$defs/Quantity"
        }
      },
      "required": [
        "name",
        "unit",
        "default",
        "min",
        "max"
      ],
      "title": "ParamDef",
      "type": "object"
    },
    "ParamTerm": {
      "additionalProperties": false,
      "description": "`factor * <value of parameter param>`. The parameter must be a length.",
      "properties": {
        "param": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Param",
          "type": "string"
        },
        "factor": {
          "title": "Factor",
          "type": "number"
        }
      },
      "required": [
        "param",
        "factor"
      ],
      "title": "ParamTerm",
      "type": "object"
    },
    "PartDef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "parameters": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ParamDef"
          },
          "title": "Parameters",
          "type": "array"
        },
        "snap_points": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SnapPoint"
          },
          "title": "Snap Points",
          "type": "array"
        },
        "specs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SpecDef"
          },
          "title": "Specs",
          "type": "array"
        },
        "shape": {
          "anyOf": [
            {
              "$ref": "#/$defs/Shape"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mass_parameter": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mass Parameter"
        },
        "role": {
          "anyOf": [
            {
              "$ref": "#/$defs/PartRole"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "curves": {
          "default": [],
          "items": {
            "$ref": "#/$defs/NamedCurve"
          },
          "title": "Curves",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "PartDef",
      "type": "object"
    },
    "PartRole": {
      "description": "What a part is for, where the simulation needs to know (B-03b). A part without a role is only a body.\n\nThe actuator on an instance must fit its part's role (`designspec.py`): a motor actuator drives a `motor` part, a\nthruster actuator a `thruster` part. What a role requires of the definition is checked by `PartDef` (the\nrequired curves, specs and parameters), so a part that says `motor` always has the numbers a motor needs and one that says\n`spring_damper` has its stiffness and damping (B-03e).",
      "enum": [
        "motor",
        "thruster",
        "wheel",
        "battery",
        "tank",
        "spring_damper"
      ],
      "title": "PartRole",
      "type": "string"
    },
    "Position": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "$ref": "#/$defs/AxisExpr"
        },
        "y": {
          "$ref": "#/$defs/AxisExpr"
        },
        "z": {
          "$ref": "#/$defs/AxisExpr"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "title": "Position",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "description": "One physical number with its unit, badge and source.",
      "properties": {
        "badge": {
          "$ref": "#/$defs/Badge"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        }
      },
      "required": [
        "badge",
        "source",
        "value",
        "unit"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "Quaternion": {
      "additionalProperties": false,
      "description": "Unit quaternion with named components (`conventions.py`).",
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "z": {
          "title": "Z",
          "type": "number"
        },
        "w": {
          "title": "W",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z",
        "w"
      ],
      "title": "Quaternion",
      "type": "object"
    },
    "Shape": {
      "additionalProperties": false,
      "description": "The recipe: one or more components. At least one is `add`; ids are unique.\n\nThe offsets and factors inside the expressions are plain numbers; like a snap point's pose, the recipe carries\none badge and source for all of them (who drew these dimensions: `declared`, or `cite` with a drawing, ...).",
      "properties": {
        "badge": {
          "$ref": "#/$defs/Badge"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/ShapeComponent"
          },
          "minItems": 1,
          "title": "Components",
          "type": "array"
        }
      },
      "required": [
        "badge",
        "source",
        "components"
      ],
      "title": "Shape",
      "type": "object"
    },
    "ShapeComponent": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "primitive": {
          "discriminator": {
            "mapping": {
              "box": "#/$defs/Box",
              "cylinder": "#/$defs/Cylinder",
              "sphere": "#/$defs/Sphere"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Box"
            },
            {
              "$ref": "#/$defs/Cylinder"
            },
            {
              "$ref": "#/$defs/Sphere"
            }
          ],
          "title": "Primitive"
        },
        "operation": {
          "default": "add",
          "enum": [
            "add",
            "subtract"
          ],
          "title": "Operation",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/Position"
        },
        "orientation": {
          "$ref": "#/$defs/Quaternion"
        }
      },
      "required": [
        "id",
        "primitive",
        "position"
      ],
      "title": "ShapeComponent",
      "type": "object"
    },
    "SnapPoint": {
      "additionalProperties": false,
      "description": "A place where this part can attach to another. `kind` and `accepts` are compatibility tags (B-04b matches them).\n\n`position` is in metres in the part's local frame and may follow length parameters; `orientation` is the\nlocal frame of the snap point. Badge and source cover the whole pose.",
      "properties": {
        "badge": {
          "$ref": "#/$defs/Badge"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Kind",
          "type": "string"
        },
        "accepts": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "type": "string"
          },
          "title": "Accepts",
          "type": "array"
        },
        "position": {
          "$ref": "#/$defs/Position"
        },
        "orientation": {
          "$ref": "#/$defs/Quaternion"
        }
      },
      "required": [
        "badge",
        "source",
        "id",
        "kind",
        "position",
        "orientation"
      ],
      "title": "SnapPoint",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "description": "Where a value comes from.\n\n`ref` is what was cited, declared or run: a document, a datasheet, a run id, or the reason a default was chosen\n(for an estimate: the method and its inputs). `locator` is where inside it (table, page, section). `url` is a\nlink when there is one. `license` (SPDX expression over the repo allowlist, `spdx.py`) and `declared_by` / `declared_at` feed the badge popover\n(`ValueBadges`, 인용 and 사용자 선언); `Provenance` allows each only on its own badge.",
      "properties": {
        "ref": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        },
        "locator": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        },
        "url": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "license": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "declared_by": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declared By"
        },
        "declared_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declared At"
        }
      },
      "required": [
        "ref"
      ],
      "title": "Source",
      "type": "object"
    },
    "SpecDef": {
      "additionalProperties": false,
      "description": "A named specification (사양): no-load speed, rated thrust, capacity ... Name and unit are the part's.",
      "properties": {
        "badge": {
          "$ref": "#/$defs/Badge"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "badge",
        "source",
        "value",
        "unit",
        "name"
      ],
      "title": "SpecDef",
      "type": "object"
    },
    "Sphere": {
      "additionalProperties": false,
      "description": "Solid sphere. `radius` [m].",
      "properties": {
        "kind": {
          "const": "sphere",
          "title": "Kind",
          "type": "string"
        },
        "radius": {
          "$ref": "#/$defs/AxisExpr"
        }
      },
      "required": [
        "kind",
        "radius"
      ],
      "title": "Sphere",
      "type": "object"
    },
    "Unit": {
      "description": "Closed unit vocabulary (SI, written the way the JSON carries it).",
      "enum": [
        "1",
        "m",
        "m^2",
        "m^3",
        "kg",
        "kg/s",
        "s",
        "rad",
        "m/s",
        "m/s^2",
        "rad/s",
        "N",
        "N*s",
        "N*m",
        "N/m",
        "N*s/m",
        "N*m/rad",
        "Pa",
        "kg/m^3",
        "kg*m^2",
        "J",
        "W",
        "W/m^2",
        "V",
        "A"
      ],
      "title": "Unit",
      "type": "string"
    }
  }
}
