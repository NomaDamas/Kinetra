{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "What a body touched: another body of the run.",
  "properties": {
    "kind": {
      "const": "body",
      "title": "Kind",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Id",
      "type": "string"
    }
  },
  "required": [
    "kind",
    "id"
  ],
  "title": "BodyTarget",
  "type": "object"
}
