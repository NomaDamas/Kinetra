{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "gravity": {
      "$ref": "#/$defs/Gravity"
    },
    "atmosphere_density": {
      "$ref": "#/$defs/AtmosphereDensity"
    },
    "insolation": {
      "$ref": "#/$defs/Insolation"
    },
    "ground_friction": {
      "$ref": "#/$defs/Assumption"
    },
    "unverified": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Unverified"
      },
      "title": "Unverified",
      "type": "array"
    }
  },
  "required": [
    "id",
    "name",
    "gravity",
    "atmosphere_density",
    "insolation",
    "ground_friction"
  ],
  "title": "Body",
  "type": "object",
  "$defs": {
    "Assumption": {
      "additionalProperties": false,
      "description": "One assumption of the verdict, as the human-review panel shows it.",
      "properties": {
        "key": {
          "description": "Stable machine key, e.g. 'vehicle_mass'. Verdict sensitivities cite it.",
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Key",
          "type": "string"
        },
        "label": {
          "description": "Name shown in the panel.",
          "maxLength": 100,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/Quantity"
        },
        "distribution": {
          "discriminator": {
            "mapping": {
              "fixed": "#/$defs/FixedDistribution",
              "normal": "#/$defs/NormalDistribution",
              "uniform": "#/$defs/UniformDistribution"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/FixedDistribution"
            },
            {
              "$ref": "#/$defs/UniformDistribution"
            },
            {
              "$ref": "#/$defs/NormalDistribution"
            }
          ],
          "title": "Distribution"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "editable": {
          "default": true,
          "title": "Editable",
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "label",
        "value",
        "confidence"
      ],
      "title": "Assumption",
      "type": "object"
    },
    "AtmosphereDensity": {
      "additionalProperties": false,
      "description": "Air density at the surface, kg/m^3. 0 is a vacuum (the Moon).",
      "properties": {
        "badge": {
          "$ref": "#/$defs/Badge"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "const": "kg/m^3",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "badge",
        "source",
        "value",
        "unit"
      ],
      "title": "AtmosphereDensity",
      "type": "object"
    },
    "Badge": {
      "enum": [
        "sim",
        "cite",
        "default",
        "declared",
        "estimate"
      ],
      "title": "Badge",
      "type": "string"
    },
    "Confidence": {
      "enum": [
        "low",
        "med",
        "high"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "FixedDistribution": {
      "additionalProperties": false,
      "description": "No spread: Monte-Carlo uses the nominal.",
      "properties": {
        "kind": {
          "const": "fixed",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "FixedDistribution",
      "type": "object"
    },
    "Gravity": {
      "additionalProperties": false,
      "description": "Uniform surface gravitational acceleration, m/s^2, > 0.",
      "properties": {
        "badge": {
          "$ref": "#/$defs/Badge"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "value": {
          "exclusiveMinimum": 0,
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "const": "m/s^2",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "badge",
        "source",
        "value",
        "unit"
      ],
      "title": "Gravity",
      "type": "object"
    },
    "Insolation": {
      "additionalProperties": false,
      "description": "Solar irradiance at the planet's mean distance from the Sun, W/m^2 (above the atmosphere, not at the ground).",
      "properties": {
        "badge": {
          "$ref": "#/$defs/Badge"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "const": "W/m^2",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "badge",
        "source",
        "value",
        "unit"
      ],
      "title": "Insolation",
      "type": "object"
    },
    "NormalDistribution": {
      "additionalProperties": false,
      "properties": {
        "badge": {
          "$ref": "#/$defs/Badge"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "kind": {
          "const": "normal",
          "title": "Kind",
          "type": "string"
        },
        "mean": {
          "title": "Mean",
          "type": "number"
        },
        "std": {
          "minimum": 0,
          "title": "Std",
          "type": "number"
        },
        "clip_low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clip Low"
        },
        "clip_high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clip High"
        }
      },
      "required": [
        "badge",
        "source",
        "kind",
        "mean",
        "std"
      ],
      "title": "NormalDistribution",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "description": "One physical number with its unit, badge and source.",
      "properties": {
        "badge": {
          "$ref": "#/$defs/Badge"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        }
      },
      "required": [
        "badge",
        "source",
        "value",
        "unit"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "description": "Where a value comes from.\n\n`ref` is what was cited, declared or run: a document, a datasheet, a run id, or the reason a default was chosen\n(for an estimate: the method and its inputs). `locator` is where inside it (table, page, section). `url` is a\nlink when there is one. `license` (SPDX expression over the repo allowlist, `spdx.py`) and `declared_by` / `declared_at` feed the badge popover\n(`ValueBadges`, 인용 and 사용자 선언); `Provenance` allows each only on its own badge.",
      "properties": {
        "ref": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        },
        "locator": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        },
        "url": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "license": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "declared_by": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declared By"
        },
        "declared_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declared At"
        }
      },
      "required": [
        "ref"
      ],
      "title": "Source",
      "type": "object"
    },
    "UniformDistribution": {
      "additionalProperties": false,
      "properties": {
        "badge": {
          "$ref": "#/$defs/Badge"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "kind": {
          "const": "uniform",
          "title": "Kind",
          "type": "string"
        },
        "low": {
          "title": "Low",
          "type": "number"
        },
        "high": {
          "title": "High",
          "type": "number"
        }
      },
      "required": [
        "badge",
        "source",
        "kind",
        "low",
        "high"
      ],
      "title": "UniformDistribution",
      "type": "object"
    },
    "Unit": {
      "description": "Closed unit vocabulary (SI, written the way the JSON carries it).",
      "enum": [
        "1",
        "m",
        "m^2",
        "m^3",
        "kg",
        "kg/s",
        "s",
        "rad",
        "m/s",
        "m/s^2",
        "rad/s",
        "N",
        "N*s",
        "N*m",
        "N/m",
        "N*s/m",
        "N*m/rad",
        "Pa",
        "kg/m^3",
        "kg*m^2",
        "J",
        "W",
        "W/m^2",
        "V",
        "A"
      ],
      "title": "Unit",
      "type": "string"
    },
    "Unverified": {
      "additionalProperties": false,
      "description": "A constant that is not a cited number, and why.",
      "properties": {
        "item": {
          "enum": [
            "gravity",
            "atmosphere_density",
            "insolation",
            "ground_friction"
          ],
          "title": "Item",
          "type": "string"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "item",
        "reason"
      ],
      "title": "Unverified",
      "type": "object"
    }
  }
}
