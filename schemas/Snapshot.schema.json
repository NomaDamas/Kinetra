{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The whole document at `revision`, of the document life `epoch`.",
  "properties": {
    "type": {
      "const": "snapshot",
      "title": "Type",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Project Id",
      "type": "string"
    },
    "epoch": {
      "minLength": 1,
      "title": "Epoch",
      "type": "string"
    },
    "revision": {
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "verdict": {
      "$ref": "#/$defs/VerdictState"
    },
    "project": {
      "$ref": "#/$defs/Project"
    }
  },
  "required": [
    "type",
    "project_id",
    "epoch",
    "revision",
    "verdict",
    "project"
  ],
  "title": "Snapshot",
  "type": "object",
  "$defs": {
    "ActuateEntry": {
      "additionalProperties": false,
      "description": "Command `command` on `actuator` during `[start, end)` seconds of simulated time.\n\n`command` is the fraction of the actuator's full command, in [-1, 1] for a motor (sign is direction) and\n[0, 1] for a thruster. What full command means physically comes from the part (B-03b, B-03c, X-01b, X-01c).\nOne badge and source cover the entry. `id` names the entry inside the schedule (unique there): commands\nthat edit an entry name it by id, never by position, so a reordered or partly accepted batch cannot change\na different entry than the one meant.",
      "properties": {
        "badge": {
          "$ref": "#/$defs/Badge"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "type": {
          "const": "actuate",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "actuator": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Actuator",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "number"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "number"
        },
        "command": {
          "maximum": 1,
          "minimum": -1,
          "title": "Command",
          "type": "number"
        }
      },
      "required": [
        "badge",
        "source",
        "type",
        "id",
        "actuator",
        "start",
        "end",
        "command"
      ],
      "title": "ActuateEntry",
      "type": "object"
    },
    "Actuator": {
      "additionalProperties": false,
      "description": "Something on `instance` that a command drives. A motor drives one joint (`joint`); a thruster has none.",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ActuatorKind"
        },
        "instance": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Instance",
          "type": "string"
        },
        "joint": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Joint"
        }
      },
      "required": [
        "id",
        "kind",
        "instance"
      ],
      "title": "Actuator",
      "type": "object"
    },
    "ActuatorKind": {
      "enum": [
        "motor",
        "thruster"
      ],
      "title": "ActuatorKind",
      "type": "string"
    },
    "Assumption": {
      "additionalProperties": false,
      "description": "One assumption of the verdict, as the human-review panel shows it.",
      "properties": {
        "key": {
          "description": "Stable machine key, e.g. 'vehicle_mass'. Verdict sensitivities cite it.",
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Key",
          "type": "string"
        },
        "label": {
          "description": "Name shown in the panel.",
          "maxLength": 100,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/Quantity"
        },
        "distribution": {
          "discriminator": {
            "mapping": {
              "fixed": "#/$defs/FixedDistribution",
              "normal": "#/$defs/NormalDistribution",
              "uniform": "#/$defs/UniformDistribution"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/FixedDistribution"
            },
            {
              "$ref": "#/$defs/UniformDistribution"
            },
            {
              "$ref": "#/$defs/NormalDistribution"
            }
          ],
          "title": "Distribution"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "editable": {
          "default": true,
          "title": "Editable",
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "label",
        "value",
        "confidence"
      ],
      "title": "Assumption",
      "type": "object"
    },
    "AssumptionTable": {
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Assumption"
          },
          "title": "Assumptions",
          "type": "array"
        }
      },
      "title": "AssumptionTable",
      "type": "object"
    },
    "AxisExpr": {
      "additionalProperties": false,
      "description": "A length in metres: `offset + sum(factor * param)`. A snap point coordinate in the part's local frame, or a\ndimension of a shape component (`shape.py`). Every `param` is a length parameter of the part.",
      "properties": {
        "offset": {
          "title": "Offset",
          "type": "number"
        },
        "terms": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ParamTerm"
          },
          "title": "Terms",
          "type": "array"
        }
      },
      "required": [
        "offset"
      ],
      "title": "AxisExpr",
      "type": "object"
    },
    "Badge": {
      "enum": [
        "sim",
        "cite",
        "default",
        "declared",
        "estimate"
      ],
      "title": "Badge",
      "type": "string"
    },
    "Box": {
      "additionalProperties": false,
      "description": "Rectangular block. `size_*` are full extents [m] along the component's local x, y, z.",
      "properties": {
        "kind": {
          "const": "box",
          "title": "Kind",
          "type": "string"
        },
        "size_x": {
          "$ref": "#/$defs/AxisExpr"
        },
        "size_y": {
          "$ref": "#/$defs/AxisExpr"
        },
        "size_z": {
          "$ref": "#/$defs/AxisExpr"
        }
      },
      "required": [
        "kind",
        "size_x",
        "size_y",
        "size_z"
      ],
      "title": "Box",
      "type": "object"
    },
    "BreakThreshold": {
      "additionalProperties": false,
      "description": "Joint load [N] above which the joint releases. A simplified model, not FEM (plan 4.6).",
      "properties": {
        "badge": {
          "$ref": "#/$defs/Badge"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "value": {
          "exclusiveMinimum": 0,
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "const": "N",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "badge",
        "source",
        "value",
        "unit"
      ],
      "title": "BreakThreshold",
      "type": "object"
    },
    "Confidence": {
      "enum": [
        "low",
        "med",
        "high"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "ControlSchedule": {
      "additionalProperties": false,
      "description": "The time-axis control program. Entries are kept in the order given; time order is not required. Entry ids\nare unique inside the schedule.",
      "properties": {
        "entries": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ActuateEntry"
          },
          "title": "Entries",
          "type": "array"
        }
      },
      "title": "ControlSchedule",
      "type": "object"
    },
    "Curve": {
      "additionalProperties": false,
      "description": "Piecewise-linear `y(x)`: at least two points, `x` strictly increasing, in `x_unit` and `y_unit`.",
      "properties": {
        "badge": {
          "$ref": "#/$defs/Badge"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "x_unit": {
          "$ref": "#/$defs/Unit"
        },
        "y_unit": {
          "$ref": "#/$defs/Unit"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/CurvePoint"
          },
          "minItems": 2,
          "title": "Points",
          "type": "array"
        }
      },
      "required": [
        "badge",
        "source",
        "x_unit",
        "y_unit",
        "points"
      ],
      "title": "Curve",
      "type": "object"
    },
    "CurvePoint": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "CurvePoint",
      "type": "object"
    },
    "Cylinder": {
      "additionalProperties": false,
      "description": "Solid circular cylinder. `radius` and `length` [m]; the axis is the component's local z.",
      "properties": {
        "kind": {
          "const": "cylinder",
          "title": "Kind",
          "type": "string"
        },
        "radius": {
          "$ref": "#/$defs/AxisExpr"
        },
        "length": {
          "$ref": "#/$defs/AxisExpr"
        }
      },
      "required": [
        "kind",
        "radius",
        "length"
      ],
      "title": "Cylinder",
      "type": "object"
    },
    "Density": {
      "additionalProperties": false,
      "properties": {
        "badge": {
          "$ref": "#/$defs/Badge"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "value": {
          "exclusiveMinimum": 0,
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "const": "kg/m^3",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "badge",
        "source",
        "value",
        "unit"
      ],
      "title": "Density",
      "type": "object"
    },
    "DesignSpec": {
      "additionalProperties": false,
      "properties": {
        "materials": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Material"
          },
          "title": "Materials",
          "type": "array"
        },
        "parts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PartDef"
          },
          "title": "Parts",
          "type": "array"
        },
        "instances": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Instance"
          },
          "title": "Instances",
          "type": "array"
        },
        "joints": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Joint"
          },
          "title": "Joints",
          "type": "array"
        },
        "actuators": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Actuator"
          },
          "title": "Actuators",
          "type": "array"
        },
        "schedule": {
          "$ref": "#/$defs/ControlSchedule",
          "default": {
            "entries": []
          }
        }
      },
      "title": "DesignSpec",
      "type": "object"
    },
    "ElasticModulus": {
      "additionalProperties": false,
      "properties": {
        "badge": {
          "$ref": "#/$defs/Badge"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "value": {
          "exclusiveMinimum": 0,
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "const": "Pa",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "badge",
        "source",
        "value",
        "unit"
      ],
      "title": "ElasticModulus",
      "type": "object"
    },
    "FixedDistribution": {
      "additionalProperties": false,
      "description": "No spread: Monte-Carlo uses the nominal.",
      "properties": {
        "kind": {
          "const": "fixed",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "FixedDistribution",
      "type": "object"
    },
    "Friction": {
      "additionalProperties": false,
      "description": "Dimensionless Coulomb coefficient.",
      "properties": {
        "badge": {
          "$ref": "#/$defs/Badge"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "const": "1",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "badge",
        "source",
        "value",
        "unit"
      ],
      "title": "Friction",
      "type": "object"
    },
    "Incline": {
      "additionalProperties": false,
      "description": "Slope angle above the ground in radians, strictly between 0 and pi/2.",
      "properties": {
        "badge": {
          "$ref": "#/$defs/Badge"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "value": {
          "exclusiveMaximum": 1.5707963267948966,
          "exclusiveMinimum": 0,
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "const": "rad",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "badge",
        "source",
        "value",
        "unit"
      ],
      "title": "Incline",
      "type": "object"
    },
    "Instance": {
      "additionalProperties": false,
      "description": "One placed part. Parameters not listed take the `PartDef` default. `material` is optional: a part whose\nmass is declared by its own specs needs none; `None` means no material is assigned.",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "part": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Part",
          "type": "string"
        },
        "parameters": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ParamValue"
          },
          "title": "Parameters",
          "type": "array"
        },
        "material": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Material"
        },
        "pose": {
          "$ref": "#/$defs/Pose"
        }
      },
      "required": [
        "id",
        "part",
        "pose"
      ],
      "title": "Instance",
      "type": "object"
    },
    "Joint": {
      "additionalProperties": false,
      "description": "A connection between two snap points of two different instances. `a` is the parent side by convention.\n\n`axis` (hinge and slider): the line the one free motion is about or along, in the frame of the `a` snap point\n(`JointAxis`). `None` is +Z of that frame (`DEFAULT_JOINT_AXIS`). A fixed joint has no motion and so no axis.\n`limits` are optional (`None`: unlimited, as a wheel axle) and not allowed on a fixed joint; they bound the joint\ncoordinate, which is 0 at the saved pose (`JointLimits`).\n`break_threshold` is optional (`None`: never breaks).",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/JointKind"
        },
        "a": {
          "$ref": "#/$defs/SnapRef"
        },
        "b": {
          "$ref": "#/$defs/SnapRef"
        },
        "axis": {
          "anyOf": [
            {
              "$ref": "#/$defs/JointAxis"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "limits": {
          "anyOf": [
            {
              "$ref": "#/$defs/JointLimits"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "break_threshold": {
          "anyOf": [
            {
              "$ref": "#/$defs/BreakThreshold"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "kind",
        "a",
        "b"
      ],
      "title": "Joint",
      "type": "object"
    },
    "JointAxis": {
      "additionalProperties": false,
      "description": "The direction a hinge turns about or a slider moves along: a unit vector in the frame of the snap point of\nthe joint's `a` end (the parent side), the same frame a snap point's `orientation` gives. One badge and source\ncover the vector. The sense is right-handed for a hinge (positive angle turns `b` counter-clockwise seen from\nthe tip of the axis) and positive travel is along the vector for a slider. `-axis` describes the same line of\nmotion with the sign of the coordinate (and so of its limits and of a motor command) flipped.",
      "properties": {
        "badge": {
          "$ref": "#/$defs/Badge"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "z": {
          "title": "Z",
          "type": "number"
        }
      },
      "required": [
        "badge",
        "source",
        "x",
        "y",
        "z"
      ],
      "title": "JointAxis",
      "type": "object"
    },
    "JointKind": {
      "enum": [
        "fixed",
        "hinge",
        "slider"
      ],
      "title": "JointKind",
      "type": "string"
    },
    "JointLimits": {
      "additionalProperties": false,
      "description": "Travel limits of the joint coordinate: rad for a hinge, m for a slider. `lower < upper`.\n\nThe coordinate is 0 at the saved pose, so the saved pose must be inside its own limits: `lower <= 0 <= upper`\n(a joint saved outside its travel would start in violation of its own limit). Both ends are inclusive.",
      "properties": {
        "lower": {
          "$ref": "#/$defs/Quantity"
        },
        "upper": {
          "$ref": "#/$defs/Quantity"
        }
      },
      "required": [
        "lower",
        "upper"
      ],
      "title": "JointLimits",
      "type": "object"
    },
    "Material": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "density": {
          "$ref": "#/$defs/Density"
        },
        "yield_strength": {
          "$ref": "#/$defs/YieldStrength"
        },
        "elastic_modulus": {
          "$ref": "#/$defs/ElasticModulus"
        },
        "friction": {
          "$ref": "#/$defs/Friction"
        }
      },
      "required": [
        "id",
        "name",
        "density",
        "yield_strength",
        "elastic_modulus",
        "friction"
      ],
      "title": "Material",
      "type": "object"
    },
    "NamedCurve": {
      "additionalProperties": false,
      "description": "A curve a part defines under a name (`torque_speed` for a motor, `thrust` for a thruster).",
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "curve": {
          "$ref": "#/$defs/Curve"
        }
      },
      "required": [
        "name",
        "curve"
      ],
      "title": "NamedCurve",
      "type": "object"
    },
    "NormalDistribution": {
      "additionalProperties": false,
      "properties": {
        "badge": {
          "$ref": "#/$defs/Badge"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "kind": {
          "const": "normal",
          "title": "Kind",
          "type": "string"
        },
        "mean": {
          "title": "Mean",
          "type": "number"
        },
        "std": {
          "minimum": 0,
          "title": "Std",
          "type": "number"
        },
        "clip_low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clip Low"
        },
        "clip_high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clip High"
        }
      },
      "required": [
        "badge",
        "source",
        "kind",
        "mean",
        "std"
      ],
      "title": "NormalDistribution",
      "type": "object"
    },
    "ParamDef": {
      "additionalProperties": false,
      "description": "A named parameter of the part with its default and allowed range, all in `unit`.",
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        },
        "default": {
          "$ref": "#/$defs/Quantity"
        },
        "min": {
          "$ref": "#/$defs/Quantity"
        },
        "max": {
          "$ref": "#/$defs/Quantity"
        }
      },
      "required": [
        "name",
        "unit",
        "default",
        "min",
        "max"
      ],
      "title": "ParamDef",
      "type": "object"
    },
    "ParamTerm": {
      "additionalProperties": false,
      "description": "`factor * <value of parameter param>`. The parameter must be a length.",
      "properties": {
        "param": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "title": "Param",
          "type": "string"
        },
        "factor": {
          "title": "Factor",
          "type": "number"
        }
      },
      "required": [
        "param",
        "factor"
      ],
      "title": "ParamTerm",
      "type": "object"
    },
    "ParamValue": {
      "additionalProperties": false,
      "description": "The value of one of the part's parameters for this instance. Unit and range are the `ParamDef`'s.",
