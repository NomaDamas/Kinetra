{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "⑦ The settings the run actually used: integrator, `timestep_s` [s] and the solver's settings by name.",
  "properties": {
    "integrator": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Integrator",
      "type": "string"
    },
    "timestep_s": {
      "exclusiveMinimum": 0,
      "title": "Timestep S",
      "type": "number"
    },
    "solver": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "string"
          }
        ]
      },
      "title": "Solver",
      "type": "object"
    }
  },
  "required": [
    "integrator",
    "timestep_s",
    "solver"
  ],
  "title": "ComputeTag",
  "type": "object"
}
