{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "discriminator": {
    "mapping": {
      "ramp": "#/$defs/RampProp",
      "step": "#/$defs/StepProp"
    },
    "propertyName": "kind"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/RampProp"
    },
    {
      "$ref": "#/$defs/StepProp"
    }
  ],
  "$defs": {
    "Badge": {
      "enum": [
        "sim",
        "cite",
        "default",
        "declared",
        "estimate"
      ],
      "title": "Badge",
      "type": "string"
    },
    "Incline": {
      "additionalProperties": false,
      "description": "Slope angle above the ground in radians, strictly between 0 and pi/2.",
      "properties": {
        "badge": {
          "$ref": "#/$defs/Badge"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "value": {
          "exclusiveMaximum": 1.5707963267948966,
          "exclusiveMinimum": 0,
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "const": "rad",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "badge",
        "source",
        "value",
        "unit"
      ],
      "title": "Incline",
      "type": "object"
    },
    "Placement": {
      "additionalProperties": false,
      "description": "Where a prop stands on the ground: centre `x`, `y` [m] and rotation `yaw` [rad] about +Z (counter-clockwise\nseen from above). One badge and source cover the whole placement.",
      "properties": {
        "badge": {
          "$ref": "#/$defs/Badge"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "yaw": {
          "title": "Yaw",
          "type": "number"
        }
      },
      "required": [
        "badge",
        "source",
        "x",
        "y",
        "yaw"
      ],
      "title": "Placement",
      "type": "object"
    },
    "PropSize": {
      "additionalProperties": false,
      "description": "A prop dimension in metres, > 0.",
      "properties": {
        "badge": {
          "$ref": "#/$defs/Badge"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "value": {
          "exclusiveMinimum": 0,
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "const": "m",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "badge",
        "source",
        "value",
        "unit"
      ],
      "title": "PropSize",
      "type": "object"
    },
    "RampProp": {
      "additionalProperties": false,
      "description": "Rises along local +x. `length` is the horizontal run.",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "material": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ID of the Material of the prop's surface; None is the planet's ground.",
          "title": "Material"
        },
        "placement": {
          "$ref": "#/$defs/Placement"
        },
        "length": {
          "$ref": "#/$defs/PropSize"
        },
        "width": {
          "$ref": "#/$defs/PropSize"
        },
        "kind": {
          "const": "ramp",
          "title": "Kind",
          "type": "string"
        },
        "incline": {
          "$ref": "#/$defs/Incline"
        }
      },
      "required": [
        "id",
        "placement",
        "length",
        "width",
        "kind",
        "incline"
      ],
      "title": "RampProp",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "description": "Where a value comes from.\n\n`ref` is what was cited, declared or run: a document, a datasheet, a run id, or the reason a default was chosen\n(for an estimate: the method and its inputs). `locator` is where inside it (table, page, section). `url` is a\nlink when there is one. `license` (SPDX expression over the repo allowlist, `spdx.py`) and `declared_by` / `declared_at` feed the badge popover\n(`ValueBadges`, 인용 and 사용자 선언); `Provenance` allows each only on its own badge.",
      "properties": {
        "ref": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        },
        "locator": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        },
        "url": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "license": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "declared_by": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declared By"
        },
        "declared_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declared At"
        }
      },
      "required": [
        "ref"
      ],
      "title": "Source",
      "type": "object"
    },
    "StepProp": {
      "additionalProperties": false,
      "description": "A box `height` tall (턱).",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "material": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ID of the Material of the prop's surface; None is the planet's ground.",
          "title": "Material"
        },
        "placement": {
          "$ref": "#/$defs/Placement"
        },
        "length": {
          "$ref": "#/$defs/PropSize"
        },
        "width": {
          "$ref": "#/$defs/PropSize"
        },
        "kind": {
          "const": "step",
          "title": "Kind",
          "type": "string"
        },
        "height": {
          "$ref": "#/$defs/PropSize"
        }
      },
      "required": [
        "id",
        "placement",
        "length",
        "width",
        "kind",
        "height"
      ],
      "title": "StepProp",
      "type": "object"
    }
  }
}
