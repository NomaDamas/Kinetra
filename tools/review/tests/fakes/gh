#!/usr/bin/env python3
"""테스트 전용 gh 대체물(네트워크 없음). FAKE_GH_DIR 의 픽스처를 읽고, 게시는 FAKE_GH_STATE(JSON)에 쌓는다.

지원: repo view / pr view / issue view / pr diff / api(contents, 코멘트 목록·PATCH) / pr comment
FAKE_GH_LOG 가 있으면 인자를 한 줄씩 덧붙인다(키가 새지 않는지 보는 시험용).
"""
import json
import os
import sys
from pathlib import Path

a = sys.argv[1:]
d = Path(os.environ["FAKE_GH_DIR"])
log = os.environ.get("FAKE_GH_LOG")
if log:
    with open(log, "a", encoding="utf-8") as f:
        f.write(json.dumps(a, ensure_ascii=False) + "\n")


def state():
    p = Path(os.environ["FAKE_GH_STATE"])
    return p, (json.loads(p.read_text()) if p.exists() else {"comments": [], "next_id": 1})


def opt(flag):
    return a[a.index(flag) + 1]


def fail(msg, code=1):
    sys.stderr.write(msg + "\n")
    sys.exit(code)


if a[:2] == ["repo", "view"]:
    print("o/r")
elif a[:2] == ["pr", "view"]:
    print((d / "pr.json").read_text())
elif a[:2] == ["issue", "view"]:
    p = d / f"issue-{a[2]}.json"
    if not p.exists():
        fail(f"GraphQL: Could not resolve to an issue with the number of {a[2]}.")
    print(p.read_text())
elif a[:2] == ["pr", "diff"]:
    print((d / "diff.patch").read_text(), end="")
elif a[:1] == ["api"] and any(x.startswith("repos/o/r/contents/") for x in a):
    path = [x for x in a if x.startswith("repos/o/r/contents/")][0].split("contents/", 1)[1].split("?", 1)[0]
    p = d / "contents" / path
    if not p.exists():
        fail("gh: Not Found (HTTP 404)")
    print(p.read_text(), end="")
elif a[:1] == ["api"] and any(x.startswith("repos/o/r/issues/") and x.endswith("/comments") for x in a) and "POST" not in a:
    _, st = state()
    print(json.dumps([{"id": c["id"], "body": c["body"]} for c in st["comments"]]))
elif a[:1] == ["api"] and "PATCH" in a:
    p, st = state()
    cid = int(a[-1].rsplit("/", 1)[1]) if a[-1].startswith("repos/") else int([x for x in a if x.startswith("repos/")][0].rsplit("/", 1)[1])
    body = sys.stdin.read() if "--input" in a else next(x[5:] for x in a if x.startswith("body="))
    if "--input" in a:
        body = json.loads(body)["body"]
    for c in st["comments"]:
        if c["id"] == cid:
            c["body"] = body
            break
    else:
        fail("gh: Not Found (HTTP 404)")
    p.write_text(json.dumps(st))
elif a[:2] == ["pr", "comment"]:
    p, st = state()
    body = sys.stdin.read() if opt("--body-file") == "-" else Path(opt("--body-file")).read_text()
    st["comments"].append({"id": st["next_id"], "body": body})
    st["next_id"] += 1
    p.write_text(json.dumps(st))
else:
    fail(f"fake gh: unsupported {a}", 2)
