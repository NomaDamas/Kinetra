{
  "name": "@kinetra/ui",
  "private": true,
  "version": "0.0.0",
  "description": "Kinetra design-system tokens and components (from approved Claude Design exports)",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./tokens.css": "./tokens/tokens.css",
    "./components.css": "./src/components.css"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "lint": "tsc --noEmit && node scripts/build-tokens.mjs --check",
    "build": "node scripts/build-tokens.mjs && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "preview": "node scripts/build-preview.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
