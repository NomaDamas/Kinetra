{
  // Static site: `pnpm build` then `pnpm dlx wrangler pages deploy dist` (or `wrangler deploy` with assets).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kinetra-demo",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
